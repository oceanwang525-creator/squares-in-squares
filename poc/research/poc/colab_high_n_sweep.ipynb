   "source": [
    "# 6. Stream Inspection: Top Improvements & Summary\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "stream_path = Path(\"outputs/high_n_stream.jsonl\")\n",
    "if stream_path.exists():\n",
    "    records = []\n",
    "    with open(stream_path, \"r\", encoding=\"utf-8\") as f:\n",
    "        for line in f:\n",
    "            if line.strip():\n",
    "                records.append(json.loads(line))\n",
    "\n",
    "    print(f\"Total Streamed Candidates: {len(records)}\")\n",
    "    improvements = [r for r in records if r.get(\"is_improvement\")]\n",
    "    matches = [r for r in records if r.get(\"is_match\")]\n",
    "    print(f\"Strict Improvements: {len(improvements)}\")\n",
    "    print(f\"Exact Matches: {len(matches)}\")\n",
    "\n",
    "    if improvements:\n",
    "        print(\"\\nTop Improvements:\")\n",
    "        improvements.sort(key=lambda r: r.get(\"delta_L\", 0.0))\n",
    "        for imp in improvements[:10]:\n",
    "            print(f\"  n={imp['n']:4d} | Delta L: {imp['delta_L']:+.6e} | Family: {imp['family']}\")\n",
    "else:\n",
    "    print(\"Stream log outputs/high_n_stream.jsonl not found yet.\")"
   ]
  },
